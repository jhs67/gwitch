{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/ipc/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "types": [
      "electron-vite/node"
    ],
    "paths": {
      "@ipc/*": [
        "./src/ipc/*"
      ]
    }
  }
}
